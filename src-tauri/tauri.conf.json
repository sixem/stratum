{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stratum",
  "version": "0.2.3",
  "identifier": "com.emy.stratum",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stratum",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#0a0b10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: asset: http://asset.localhost stratum-preview: http://stratum-preview.localhost",
        "media-src": "'self' stratum-preview: http://stratum-preview.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: asset: http://asset.localhost stratum-preview: http://stratum-preview.localhost",
        "media-src": "'self' stratum-preview: http://stratum-preview.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/thumbs/**", "$APPLOCALDATA/icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
